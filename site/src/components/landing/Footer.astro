---
// S9: docs index, conformance, license, and the verbatim legal notice.
import { landingCopy } from '../../data/landing-copy';
import LegalNotice from '../LegalNotice.astro';
import Lockup from './Lockup.astro';

const copy = landingCopy.footer;
---

<footer class="foot">
	<div class="wrap">
		<div class="foot-grid">
			<div class="foot-brand">
				<a class="brand" href="/" aria-label={landingCopy.header.homeLabel}><Lockup /></a>
				<p>{copy.tagline}</p>
			</div>
			<nav class="foot-nav" aria-label={copy.navLabel} style={`--foot-cols: ${copy.groups.length}`}>
				{
					copy.groups.map((group) => (
						<div>
							<p class="foot-h">{group.heading}</p>
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>
		<div class="foot-legal">
			<LegalNotice />
			<a class="tertiary" href="#top">{copy.top}</a>
		</div>
	</div>
</footer>

<style>
	/*
	 * One column per footer group on wide screens, two per row below the
	 * 1060px breakpoint landing.css uses. Astro scopes these selectors with
	 * :where(), which adds no specificity, so the parent class is what lets
	 * them win over the 3-column rule in landing.css.
	 */
	.foot-grid .foot-nav {
		grid-template-columns: repeat(var(--foot-cols), minmax(0, 1fr));
	}
	@media (max-width: 1060px) {
		.foot-grid .foot-nav {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
