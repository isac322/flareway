---
// GitHub link with a star nudge, matching the landing header's `.fw-gh` pill.
// The count renders only when the build-time fetch succeeded; never estimated.
import { formatStars, getStars, REPO_URL } from '../../data/github';

const stars = await getStars();
const label = `Star Flareway on GitHub${stars !== undefined ? ` (${stars} stars)` : ''}`;
---

<a class="fw-gh" href={REPO_URL} aria-label={label}>
	<svg class="fw-gh-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
		></path>
	</svg>
	<span class="fw-gh-label">GitHub</span>
	<span class="fw-gh-star" aria-hidden="true">
		<svg viewBox="0 0 16 16" focusable="false">
			<path d="M8 1.2l2.05 4.3 4.7.6-3.45 3.25.87 4.66L8 11.73 3.83 14l.87-4.66L1.25 6.1l4.7-.6z"></path>
		</svg>
		<span class="fw-gh-word">Star</span>
		{stars !== undefined && <span class="num">{formatStars(stars)}</span>}
	</span>
</a>

<style>
	.fw-gh {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--fw-line);
		border-radius: 8px;
		background: var(--fw-panel);
		color: var(--fw-ink);
		font: 500 0.875rem/1 var(--fw-font-sans);
		text-decoration: none;
		white-space: nowrap;
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}
	.fw-gh:hover,
	.fw-gh:focus-visible {
		border-color: var(--fw-ink-2);
	}
	.fw-gh-mark {
		width: 1.125rem;
		height: 1.125rem;
		flex: none;
	}
	.fw-gh-star {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin-inline-start: 2px;
		padding-inline-start: 0.625rem;
		border-inline-start: 1px solid var(--fw-line);
		align-self: stretch;
		color: var(--fw-ink-2);
	}
	.fw-gh-star svg {
		width: 14px;
		height: 14px;
		flex: none;
		fill: var(--fw-accent);
		stroke: var(--fw-accent-ink);
		stroke-width: 1;
		stroke-linejoin: round;
		transition: transform 0.3s var(--fw-ease);
	}
	.fw-gh:hover .fw-gh-star svg,
	.fw-gh:focus-visible .fw-gh-star svg {
		transform: rotate(-12deg);
	}
	.num {
		color: var(--fw-ink);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	@media (prefers-reduced-motion: reduce) {
		.fw-gh-star svg {
			transition: none;
		}
		.fw-gh:hover .fw-gh-star svg,
		.fw-gh:focus-visible .fw-gh-star svg {
			transform: none;
		}
	}
	@media (max-width: 40rem) {
		.fw-gh {
			gap: 0;
			padding-inline: 0.625rem;
		}
		.fw-gh-label {
			display: none;
		}
		.fw-gh-star {
			margin-inline-start: 0.5rem;
		}
	}
	@media (max-width: 26rem) {
		.fw-gh-word {
			display: none;
		}
	}
</style>
