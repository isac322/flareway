---
// Docs header: lockup, search, GitHub star link, theme picker, and the
// site-wide tab row from data/nav.ts. The active tab cuts a doorway notch into
// the header rule with a small orange door leaf, as on the landing header.
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { activeTab, tabs } from '../../data/nav';
import GitHubStar from './GitHubStar.astro';
import SiteTitle from './SiteTitle.astro';

// Pagefind search stays enabled in astro.config.mjs, so search always renders.
const current = activeTab(Astro.url.pathname);
---

<div class="fw-header">
	<div class="fw-bar">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>
		<div class="sl-flex print:hidden">
			<Search />
		</div>
		<div class="fw-end print:hidden">
			<GitHubStar />
			<div class="fw-prefs sl-hidden md:sl-flex">
				<ThemeSelect />
				<LanguageSelect />
			</div>
		</div>
	</div>
	<nav class="fw-tabs print:hidden" aria-label="Documentation sections">
		<ul>
			{
				tabs.map((tab) => (
					<li>
						<a href={tab.href} aria-current={tab === current ? 'page' : undefined}>
							<span>{tab.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<style>
	.fw-header {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	/* ---- top bar ---------------------------------------------------------- */
	.fw-bar {
		flex: 1;
		min-height: 0;
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
	}
	.title-wrapper {
		/* Long titles must not cover the search and menu buttons on narrow viewports. */
		overflow: clip;
		/* Room for the focus ring around the title link. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	.fw-end {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.fw-prefs {
		align-items: center;
		gap: 1rem;
	}
	.fw-prefs::before {
		content: '';
		height: 1.75rem;
		border-inline-start: 1px solid var(--fw-line);
	}

	/* Desktop: Starlight's column math, so search lines up with the content column. */
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.fw-bar {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
				1fr
				auto;
			align-content: center;
		}
	}

	/* ---- tab row ---------------------------------------------------------- */
	.fw-tabs {
		--fw-notch-drop: 6px;
		flex: none;
		/* The row extends a few pixels past the header rule so the notch and
		   door leaf, which cross the rule, are not clipped by the scroller. */
		height: calc(var(--fw-tabs-height) + var(--fw-notch-drop));
		padding-bottom: var(--fw-notch-drop);
		margin-bottom: calc(-1 * var(--fw-notch-drop));
		margin-inline: calc(-1 * var(--sl-nav-pad-x));
		padding-inline: calc(var(--sl-nav-pad-x) - 0.625rem);
		/* Mobile: tabs scroll horizontally instead of wrapping. */
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		pointer-events: none;
	}
	.fw-tabs::-webkit-scrollbar {
		display: none;
	}
	@media (max-width: 49.99rem) {
		/* The mobile menu button reserves header padding; the scroller still spans edge to edge. */
		:global([data-has-sidebar]) .fw-tabs {
			margin-inline-end: calc(-1 * (var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)));
		}
	}

	.fw-tabs ul {
		display: flex;
		gap: 0.125rem;
		width: max-content;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		pointer-events: auto;
	}
	.fw-tabs li {
		flex: none;
		display: flex;
	}

	.fw-tabs a {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
		color: var(--fw-ink-2);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		outline: none;
	}
	.fw-tabs a span {
		padding: 0.375rem 0.625rem;
		border-radius: 8px;
		transition:
			color 0.2s,
			background-color 0.2s;
	}
	.fw-tabs a:hover {
		color: var(--fw-ink);
	}
	.fw-tabs a:hover span {
		background: var(--fw-tint);
	}
	.fw-tabs a:focus-visible span {
		outline: 2px solid var(--fw-ink);
		outline-offset: -2px;
	}
	.fw-tabs a[aria-current='page'] {
		color: var(--fw-ink);
		font-weight: 600;
	}

	/* Doorway notch: the jambs rise out of the header rule and the rule is
	   interrupted between them. */
	.fw-tabs a[aria-current='page']::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -1px;
		width: 18px;
		height: 11px;
		margin-left: -9px;
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--fw-ink-2);
		border-bottom: 0;
	}
	/* The door leaf, swung open across the threshold. */
	.fw-tabs a[aria-current='page']::before {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -4px;
		z-index: 1;
		width: 5px;
		height: 11px;
		margin-left: -7px;
		background: var(--fw-accent);
		transform: skewY(var(--fw-door-slant));
		transform-origin: 0 0;
	}
</style>
