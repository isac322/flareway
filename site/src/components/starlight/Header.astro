---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import { activeTab, tabs } from '../../data/nav';

const current = activeTab(Astro.url.pathname);
---

<div class="fw-header">
	<DefaultHeader />
	<nav class="fw-tabs print:hidden" aria-label="Documentation sections">
		<ul>
			{
				tabs.map((tab) => (
					<li>
						<a href={tab.href} aria-current={tab === current ? 'page' : undefined}>
							{tab.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<style>
	.fw-header {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	/* Starlight's own header row keeps its layout, sized to the original bar height. */
	.fw-header > :global(.header) {
		flex: 1;
		min-height: 0;
	}

	.fw-tabs {
		flex: none;
		height: var(--fw-tabs-height);
		/* Mobile: tabs scroll horizontally instead of wrapping. */
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		margin-inline: calc(-1 * var(--sl-nav-pad-x));
		padding-inline: var(--sl-nav-pad-x);
	}
	.fw-tabs::-webkit-scrollbar {
		display: none;
	}

	.fw-tabs ul {
		display: flex;
		gap: 0.25rem;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fw-tabs li {
		flex: none;
		display: flex;
	}

	.fw-tabs a {
		display: flex;
		align-items: center;
		padding-inline: 0.75rem;
		/* Underline indicator sits on the header's bottom border. */
		border-bottom: 2px solid transparent;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.fw-tabs a:hover {
		color: var(--sl-color-white);
	}
	.fw-tabs a:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -2px;
		border-radius: 0.25rem;
	}
	.fw-tabs a[aria-current='page'] {
		color: var(--sl-color-white);
		border-bottom-color: var(--sl-color-text-accent);
	}
</style>
