{
  "name": "flareway-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "sync": "bun scripts/sync-docs.ts",
    "dev": "bun run sync && bun --bun astro dev",
